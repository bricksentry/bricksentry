# Runs after any watched table changes (Delta commit), checks what changed, alerts, and
# fails the run when the verdict is at least --fail-on. OPTIMIZE / VACUUM commits also
# start a run; they have no data change, so the run just finishes ("nothing to check").
resources:
  jobs:
    bricksentry_check:
      name: bricksentry check ({{.project_name}})
      max_concurrent_runs: 1
      trigger:
        pause_status: UNPAUSED
        table_update:
          table_names: [{{.tables}}]
          condition: ANY_UPDATED
          # Wait until the pipeline has stopped writing, so one run covers all its commits.
          wait_after_last_change_seconds: 120
      tasks:
        - task_key: bricksentry_check
          environment_key: default
          # A block verdict is an answer, not a flaky failure: no retries. On serverless,
          # auto-optimization retries failed tasks even with max_retries: 0, so turn it off too.
          max_retries: 0
          disable_auto_optimization: true
          spark_python_task:
            python_file: ../src/bricksentry_check.py
            parameters:
              - --tables
              - "{{`{{job.trigger.table_update.updated_tables}}`}}"
              - --default-tables
              - "{{.tables}}"
              # Every data change in the last 60 minutes is checked as one change.
              - --since-minutes
              - "60"
              - --warehouse-id
              - "{{.warehouse_id}}"
              - --scratch-schema
              - "{{.scratch_schema}}"
              - --policy
              - "{{.policy}}"
              - --fail-on
              - "{{.fail_on}}"
{{- if .keys}}
              - --keys
              - "{{.keys}}"
{{- end}}
{{- if .slack_secret}}
              - --slack-secret
              - "{{.slack_secret}}"
{{- end}}
              - --run-url
              - "{{`{{workspace.url}}/jobs/{{job.id}}/runs/{{job.run_id}}`}}"
              # Tables without a PRIMARY KEY need key columns: --keys "main.sales.orders=order_id; ..."
      environments:
        - environment_key: default
          spec:
            environment_version: "2"
            dependencies:
              # Pinned: serverless resolves the dependencies once and caches them, so a range
              # would not pick up new releases. To upgrade, change the version and redeploy.
              - bricksentry[databricks]=={{.bricksentry_version}}
{{- if eq .demo "yes"}}

    # Demo: makes a known-bad change to a demo table in {{.scratch_schema}}, then checks it.
    # `databricks bundle run bricksentry_demo` ends red with BLOCK (duplicate keys): that is
    # the expected result. Delete this job once you have seen it.
    bricksentry_demo:
      name: bricksentry demo ({{.project_name}})
      tasks:
        - task_key: make_bad_change
          environment_key: default
          max_retries: 0
          disable_auto_optimization: true
          spark_python_task:
            python_file: ../src/bricksentry_demo.py
            parameters:
              - --table
              - "{{.scratch_schema}}.bricksentry_demo_orders"
              - --warehouse-id
              - "{{.warehouse_id}}"
        - task_key: bricksentry_check
          depends_on:
            - task_key: make_bad_change
          environment_key: default
          max_retries: 0
          disable_auto_optimization: true
          spark_python_task:
            python_file: ../src/bricksentry_check.py
            parameters:
              - --tables
              - "{{.scratch_schema}}.bricksentry_demo_orders"
              - --key
              - order_id
              - --warehouse-id
              - "{{.warehouse_id}}"
              - --scratch-schema
              - "{{.scratch_schema}}"
              - --policy
              - "{{.policy}}"
              - --fail-on
              - block
{{- if .slack_secret}}
              - --slack-secret
              - "{{.slack_secret}}"
{{- end}}
              - --run-url
              - "{{`{{workspace.url}}/jobs/{{job.id}}/runs/{{job.run_id}}`}}"
      environments:
        - environment_key: default
          spec:
            environment_version: "2"
            dependencies:
              - bricksentry[databricks]=={{.bricksentry_version}}
{{- end}}
